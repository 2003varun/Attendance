# Attendance OS Pro - Frontend Environment Variables

# API Base URL:
# - In local development on the same machine, leave blank to use the Vite proxy (/api):
#   VITE_API_URL=
#
# - For multi-device access on the same local Wi-Fi / network:
#   Set this to the IP address of the machine running the backend:
#   VITE_API_URL=http://192.168.1.100:5000
#
# - For production / cloud deployment (e.g. Render, Railway, Fly.io, Heroku):
#   VITE_API_URL=https://attendance-api.onrender.com
VITE_API_URL=
