# Attendance OS Pro - Backend Configuration Template
# For Multi-Device Deployment with a Shared Database

# 1. DATABASE_URL:
# Connection URI for the shared database.
# - Cloud PostgreSQL (Supabase / Neon / Render / Railway / AWS RDS):
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# - Local SQLite (Default fallback if left unset):
#   # DATABASE_URL=sqlite:///attendance_os.db

# 2. SERVER HOST & PORT:
# Set HOST=0.0.0.0 so computers on the same network (LAN / Wi-Fi) can access the API
HOST=0.0.0.0
PORT=5000

# 3. CORS:
# Set allowed origins. Use '*' to allow any client or specify comma-separated origins.
# Example: CORS_ORIGINS=http://localhost:3000,http://192.168.1.50:3000,https://my-attendance-app.vercel.app
CORS_ORIGINS=*
